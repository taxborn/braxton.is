---
import { Icon } from "astro-icon/components";
import Layout from "../components/Layout.astro";
import { getRecord } from "../lib/atproto";

const sifaProfile = await getRecord<{ headline?: string }>(
  "id.sifa.profile.self",
);
const headline =
  sifaProfile?.headline ?? "software engineer, protocol-intrigued, cat parent";
---

<Layout>
  <div>
    <h1 class="text-5xl font-bold tracking-tight lowercase">hi, i'm braxton</h1>
    <p class="lowercase">{headline}</p>
  </div>
  <div class="py-2">
    <ul class="inline-flex gap-4">
      <li>
        <a
          href="https://bsky.app/profile/braxton.is"
          class="inline-flex items-center gap-1.5"
        >
          <Icon name="simple-icons:bluesky" class="size-4" />
          @braxton.is
        </a>
      </li>
      <li>
        <a
          href="https://code.biscuits.at/braxton"
          class="inline-flex items-center gap-1.5"
        >
          <Icon name="simple-icons:forgejo" class="size-4" />
          @braxton
        </a>
      </li>
      <li>
        <a
          href="https://sifa.id/p/braxton.is"
          class="inline-flex items-center gap-1.5"
        >
          <Icon name="boxicons:briefcase" class="size-4" />
          sifa.id
        </a>
      </li>
    </ul>
  </div>
</Layout>
