---
import { Icon } from "astro-icon/components";
import Layout from "../components/Layout.astro";
import Timeline from "../components/Timeline.astro";
import { getProfileAvatarUrl, getRecord } from "../lib/atproto";

const [sifaProfile, avatarUrl] = await Promise.all([
  getRecord<{ headline?: string }>("id.sifa.profile.self"),
  getProfileAvatarUrl(),
]);
const headline =
  sifaProfile?.headline ?? "software engineer, protocol-intrigued, cat parent";
const links = [
  {
    href: "https://bsky.app/profile/braxton.is",
    icon: "simple-icons:bluesky",
    label: "@braxton.is",
  },
  {
    href: "https://tangled.org/braxton.is",
    icon: "simple-icons:tangled",
    label: "@braxton.is",
  },
  {
    href: "https://sifa.id/p/braxton.is",
    icon: "boxicons:briefcase",
    label: "sifa.id",
  },
];
---

<Layout>
  <div class="flex flex-col items-start gap-6 py-8 sm:flex-row sm:items-center">
    {avatarUrl && (
      <img
        src={avatarUrl}
        alt="Braxton's profile picture"
        width="128"
        height="128"
        class="size-32 shrink-0 self-center rounded-full object-cover sm:order-last sm:ml-auto"
        fetchpriority="high"
      />
    )}
    <div>
      <h1 class="text-5xl font-bold tracking-tight lowercase">
        hi, i'm braxton
      </h1>
      <p class="lowercase">{headline}</p>
    </div>
  </div>
  <div class="py-2">
    <ul class="inline-flex gap-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex items-center gap-1.5 rounded-sm text-blue underline-offset-4 hover:text-mauve hover:underline focus-visible:text-mauve focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
          >
            <Icon name={link.icon} class="size-4" />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <Timeline />
</Layout>
