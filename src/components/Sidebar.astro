---
import { Icon } from "astro-icon/components";
import { getProfileAvatarUrl, getRecord } from "../lib/atproto";

const [sifaProfile, avatarUrl] = await Promise.all([
  getRecord<{ headline?: string }>("id.sifa.profile.self"),
  getProfileAvatarUrl(),
]);
const headline =
  sifaProfile?.headline ?? "software engineer, protocol-intrigued, cat parent";
const REPO_URL = "https://tangled.org/braxton.is/braxton.is";
// Injected at build time (see astro.config.mjs); empty if git was unavailable.
const commit = __LAST_COMMIT__;

const links = [
  {
    href: "https://bsky.app/profile/braxton.is",
    icon: "simple-icons:bluesky",
    site: "Bluesky",
    label: "@braxton.is",
  },
  {
    href: "https://tangled.org/braxton.is",
    icon: "simple-icons:tangled",
    site: "Tangled",
    label: "@braxton.is",
  },
  {
    href: "https://sifa.id/p/braxton.is",
    icon: "boxicons:briefcase",
    site: null,
    label: "sifa.id",
  },
];
---

<aside class="flex flex-col py-4">
  <div
    class="flex flex-row items-center gap-4 lg:sticky lg:top-4 lg:flex-col lg:items-start lg:gap-5"
  >
    {avatarUrl && (
      <img
        src={avatarUrl}
        alt="Braxton's profile picture"
        width="256"
        height="256"
        class="size-24 shrink-0 rounded-full object-cover lg:size-auto lg:w-full lg:max-w-64"
        fetchpriority="high"
      />
    )}
    <div class="flex flex-col gap-3">
      <div>
        <h1 class="text-3xl font-bold tracking-tight lowercase lg:text-4xl">
          hi, i'm braxton
        </h1>
        <p class="lowercase">{headline}</p>
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 lg:flex-col">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel="me"
              class="inline-flex items-center gap-1.5 rounded-sm text-blue underline-offset-4 hover:text-mauve hover:underline focus-visible:text-mauve focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue text-blue"
            >
              <Icon name={link.icon} class="size-4" aria-hidden="true" />
              {link.site && <span class="sr-only">{`${link.site}: `}</span>}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {commit && (
        <footer class="text-sm text-subtext0 lg:hidden">
          <a
            href={`${REPO_URL}/commit/${commit.hash}`}
            title={commit.subject}
            class="inline-flex items-center gap-1.5 rounded-sm underline-offset-4 hover:text-mauve hover:underline focus-visible:text-mauve focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
          >
            <Icon name="boxicons:git-commit" class="size-4" aria-hidden="true" />
            <span class="sr-only">Last commit: </span>
            <code>{commit.hash}</code>
          </a>
        </footer>
      )}
    </div>
  </div>
  {/* Desktop: pinned to the bottom of the viewport for the whole scroll. */}
  {commit && (
    <footer class="hidden text-sm text-subtext0 lg:sticky lg:bottom-4 lg:mt-auto lg:block">
      <a
        href={`${REPO_URL}/commit/${commit.hash}`}
        title={commit.subject}
        class="inline-flex items-center gap-1.5 rounded-sm underline-offset-4 hover:text-mauve hover:underline focus-visible:text-mauve focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
      >
        <Icon name="boxicons:git-commit" class="size-4" aria-hidden="true" />
        <span class="sr-only">Last commit: </span>
        <code>{commit.hash}</code>
      </a>
    </footer>
  )}
</aside>
