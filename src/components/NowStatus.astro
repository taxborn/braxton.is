---
import { Icon } from "astro-icon/components";
import RelativeTime from "./RelativeTime.astro";
import { getNow } from "../lib/now";

const now = await getNow();
const state = now?.state;

function batteryIcon(level: number): string {
  if (level <= 10) return "boxicons:battery";
  if (level <= 35) return "boxicons:battery-1";
  if (level <= 60) return "boxicons:battery-2";
  if (level <= 85) return "boxicons:battery-3";
  return "boxicons:battery-full";
}
---

{now && (
  <p class="inline text-subtext1">
    {now.status}{" "}
    {state && (
      <span class="inline-flex flex-wrap items-baseline gap-1.5 align-baseline text-xs">
        {state.heartRate !== null && (
          <span class="inline-flex items-baseline gap-1 whitespace-nowrap rounded-full bg-red/15 px-2 py-0.5 text-red">
            <Icon name="boxicons:heart" class="size-3.5 self-center" aria-hidden="true" />
            <span><span class="sr-only">heart rate</span> {state.heartRate} bpm</span>
          </span>
        )}
        {state.activity && (
          <span class="inline-flex items-baseline whitespace-nowrap rounded-full bg-blue/15 px-2 py-0.5 text-blue">
            {state.activity}
          </span>
        )}
        {state.batteryLevel !== null && (
          <span class="inline-flex items-baseline gap-1 whitespace-nowrap rounded-full bg-green/15 px-2 py-0.5 text-green">
            <Icon
              name={batteryIcon(state.batteryLevel)}
              class="size-3.5 self-center"
              aria-hidden="true"
            />
            <span><span class="sr-only">phone battery</span> {state.batteryLevel}%</span>
          </span>
        )}
      </span>
    )}{" "}
    {now.createdAt && (
      <RelativeTime date={now.createdAt} class="opacity-50 text-sm" />
    )}
  </p>
)}
