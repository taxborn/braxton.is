---
import "../styles/global.css";
import NowStatus from "./NowStatus.astro";
import NowPlaying from "./NowPlaying.astro";
import Sidebar from "./Sidebar.astro";
import { DID } from "../lib/atproto";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="braxton's digital garden" />
    <meta name="generator" content={Astro.generator} />
    <title>braxton.is working</title>
    <link
      rel="site.standard.document"
      href={`at://${DID}/site.standard.publication/3myqlk77shz22`}
    />
    <link rel="me" href="https://sifa.id/p/braxton.is" />
  </head>
  <body class="bg-base text-text antialiased">
    <div class="mx-auto max-w-7xl p-4">
      <header class="border-b border-surface0 pb-2">
        <nav>
          <a href="/" class="mr-2 font-bold cursor-grab">
            braxton<span class="opacity-75">.</span>is
          </a>
          <NowStatus />
        </nav>
        <NowPlaying />
      </header>
      <div class="lg:grid lg:grid-cols-4 lg:gap-8">
        <Sidebar />
        <main class="flex flex-col py-2 lg:col-span-3">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
